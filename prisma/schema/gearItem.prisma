model GearItem {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  description    String
  brand          String?
  pricePerDay    Decimal @db.Decimal(10, 2)
  totalQuantity  Int     @default(1)
  specifications Json?

  // NOTE: this is a manual provider-controlled flag only
  // (e.g. "paused"/"hidden" listing). It does NOT reflect
  // real-time date-based availability. Compute actual
  // availability at query time as:
  //   totalQuantity - (sum of overlapping active rentalOrderItems)
  isListed Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  providerId String
  provider   User   @relation("ProviderGearItems", fields: [providerId], references: [id], onDelete: Restrict)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images      GearImage[]
  rentalItems RentalOrderItem[]
  reviews     Review[]

  @@index([providerId])
  @@index([categoryId])
  @@index([slug])
  @@index([isListed])
  @@map("gear_items")
}